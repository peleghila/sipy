[case testSimpleAssignments]
# flags: --python-version 3.10
import numpy as np

i8: np.int8 = np.int8(1)
i16: np.int16 = np.int16(1)
i32: np.int32 = np.int32(1)
i64: np.int64 = np.int64(1)

i64 = i32 # E: Incompatible types in assignment (expression has type "signedinteger[_32Bit]", variable has type "signedinteger[_64Bit]")
i64 = np.int64(i32)
i32 = i16 # E: Incompatible types in assignment (expression has type "signedinteger[_16Bit]", variable has type "signedinteger[_32Bit]")
i32 = np.int32(i16)
i16 = i8 # E: Incompatible types in assignment (expression has type "signedinteger[_8Bit]", variable has type "signedinteger[_16Bit]")

f64: np.float64
f32: np.float32
f16: np.float16
f64 = f32 # E: Incompatible types in assignment (expression has type "floating[_32Bit]", variable has type "float64")
f64 = np.float64(f32)
f32 = f16 # E: Incompatible types in assignment (expression has type "floating[_16Bit]", variable has type "floating[_32Bit]")

[typing fixtures/typing-fuller.pyi]
[builtins fixtures/builtins-fuller.pyi]
