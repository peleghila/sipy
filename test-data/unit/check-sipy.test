[fixture src/SUnit1/SIUnit.py]
import typing
from typing import Generic, TypeVar
NumericBase = TypeVar("NumericBase")
class SIUnitType(type): # ABCMeta):
    def __call__(self, value):
        return value

    def __invert__(self):
        print(self)
    # def __getitem__(self, item):
    #     return item
    def __mul__(self, other):
        return SIUnit
    def __pow__(self, power, modulo=None):
        return SIUnit
    def __truediv__(self, other):
        return SIUnit

class SIUnit(Generic[NumericBase],metaclass=SIUnitType):
    # def __str__(self):
    #     return str(self.num) + self.typeStr
    #
    # # Type modifying maths:
    def __mul__(self, other): pass
    def __rmul__(self, other): pass
    #
    def __truediv__(self, other): pass
    def __floordiv__(self, other): pass
    def __rfloordiv__(self, other): pass
    def __rtruediv__(self, other): pass
    def __pow__(self, power, modulo=None): pass
    def __add__(self, other): pass
    def __sub__(self, other): pass
    def __radd__(self, other): pass
    def __rsub__(self, other): pass
    def __mod__(self, other): pass
    def __divmod__(self, other): pass
    def __lshift__(self, other): pass
    def __rshift__(self, other): pass

    # # def __and__(self, other): pass
    # # def __xor__(self, other): pass
    # # def __or__(self, other): pass
    #
    # # Ops w/o an other:
    def __neg__(self): pass
    def __pos__(self): pass
    def __invert__(self): pass
    def __abs__(self): pass
    def __round__(self, n=None): pass
    def __trunc__(self): pass
    def __floor__(self): pass

    def __ceil__(self): pass

    # Escape hatches:
    def __int__(self): pass
    def __float__(self): pass
def dtype(unitType):
    return typing.get_args(unitType)[0]
class Length(SIUnit[NumericBase]):
    pass
class M(Length[NumericBase]):
    def __init__(self, value: NumericBase):
        ...
class Time(SIUnit[NumericBase]):
    pass
class Sec(Time[NumericBase]):
    def __init__(self, value: NumericBase):
        ...



