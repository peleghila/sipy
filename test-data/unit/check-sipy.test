[case testFunctionParamBareUnitCompound]
# flags: --python-version 3.10
from src.SUnit1.SIUnit import M, Sec

def f(x: M[float]) -> None:
    reveal_type(x)  # N: Revealed type is "Compound(src.SUnit1.SIUnit.M[builtins.float])"

reveal_type(f)  # N: Revealed type is "def (x: Compound(src.SUnit1.SIUnit.M[builtins.float]))"
f(M(1.0))
f(Sec(1.0))  # E: Argument 1 to "f" has incompatible type "Sec[float]"; expected "M[float]"

