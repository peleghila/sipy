        reveal_type(x)  # N: Revealed type is "Compound(src.SUnit1.SIUnit.M[builtins.float])"

reveal_type(C().method)  # N: Revealed type is "def (x: Compound(src.SUnit1.SIUnit.M[builtins.float]))"
