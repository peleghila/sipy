import numpy as np
from numpy.typing import NDArray
from src.SUnit1.SIUnit import M, dtype

y0: M[np.float32] = M(np.float32(2.0))
y: NDArray[M[np.float64]] = np.zeros(2,dtype=dtype(M[np.float64]))
y[0] = y0 # E: No overload variant of "__setitem__" of "ndarray" matches argument types "int", "M[floating[_32Bit]]" \
    # N: Possible overload variants: \
    # N:     def __setitem__(self, Union[Union[SupportsIndex, slice, Any, Union[_SupportsArray[dtype[Union[numpy.bool[builtins.bool], integer[Any]]]], _NestedSequence[_SupportsArray[dtype[Union[numpy.bool[builtins.bool], integer[Any]]]]], int, _NestedSequence[int]], None], Tuple[Union[SupportsIndex, slice, Any, Union[_SupportsArray[dtype[Union[numpy.bool[builtins.bool], integer[Any]]]], _NestedSequence[_SupportsArray[dtype[Union[numpy.bool[builtins.bool], integer[Any]]]]], int, _NestedSequence[int]], None], ...]], M[float64], /) -> None \
